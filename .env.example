# ==============================================================================
# DocuNorm AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Never commit the actual .env file with secrets into version control.

# Application Environment
APP_ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_32_byte_string_for_production

# PostgreSQL Database (with pgvector)
POSTGRES_USER=docunorm_admin
POSTGRES_PASSWORD=docunorm_dev_password_change_me
POSTGRES_DB=docunorm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Task Broker
REDIS_HOST=redis
REDIS_PORT=6379

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Next.js Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Hybrid RAG & Embedding Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-large

# Local Document Storage Directory (for MinIO or local filesystem)
STORAGE_DIR=./storage
